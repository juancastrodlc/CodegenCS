<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\CodegenCS.SourceGenerator.Host.props" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CodegenCSHostTargetFramework)' != ''">netstandard2.0;$(CodegenCSHostTargetFramework)</TargetFrameworks>
    <Authors>Rick Drizin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Drizin/CodegenCS/blob/master/src/SourceGenerator/CodegenCS.SourceGenerator/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>code generation;code generator;templating;codegencs;source generator</PackageTags>
    <PackageId>CodegenCS.SourceGenerator</PackageId>
    <Description>CodegenCS Source Generator can be used to augment code (generating more code) during compilation.</Description>
    <Copyright>Rick Drizin</Copyright>
    <Company>Rick Drizin</Company>
    <Version>3.5.2</Version>
    <DocumentationFile>CodegenCS.SourceGenerator.xml</DocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>preview</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <DebugType>portable</DebugType>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CodegenCSPackAnalyzer</TargetsForTfmSpecificContentInPackage>
    <NoWarn>$(NoWarn);RS1035;RS1042;NU5128;CS1591;CS1573;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Tools\TemplateBuilder\*.cs" LinkBase="TemplateBuilder" />
    <Compile Include="..\..\Tools\TemplateLauncher\*.cs" LinkBase="TemplateLauncher" />
    <None Include="build\**" Pack="true" PackagePath="build\;buildTransitive\" />
    <InternalsVisibleTo Include="CodegenCS.SourceGenerator1.Tests" />
    <InternalsVisibleTo Include="CodegenCS.SourceGenerator2.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodegenCSRoslynPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Reference Include="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll" Private="false" />
    <Reference Include="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.CSharp.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />
    <PackageReference Include="InterpolatedColorConsole" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NSwag.Core" Version="14.7.1" PrivateAssets="all" />
    <PackageReference Include="NSwag.Core.Yaml" Version="14.7.1" PrivateAssets="all" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" PrivateAssets="all" />
    <PackageReference Include="NJsonSchema.Annotations" Version="11.6.1" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" PrivateAssets="all" />
  </ItemGroup>

  <Choose>
    <When Condition="'$(Configuration)' == 'Debug'">
      <ItemGroup>
        <ProjectReference Include="..\..\Core\CodegenCS\CodegenCS.Core.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\..\Core\CodegenCS.Runtime\CodegenCS.Runtime.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\..\Core\CodegenCS.Models\CodegenCS.Models.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\..\Core\CodegenCS.DotNet\CodegenCS.DotNet.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\..\Models\CodegenCS.Models.DbSchema\CodegenCS.Models.DbSchema.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\..\Models\CodegenCS.Models.NSwagAdapter\CodegenCS.Models.NSwagAdapter.csproj" PrivateAssets="all" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="CodegenCS.Core" Version="3.5.0" PrivateAssets="all" />
        <PackageReference Include="CodegenCS.Runtime" Version="3.5.2" PrivateAssets="all" />
        <PackageReference Include="CodegenCS.Models" Version="3.5.0" PrivateAssets="all" />
        <PackageReference Include="CodegenCS.DotNet" Version="3.5.0" PrivateAssets="all" />
        <PackageReference Include="CodegenCS.Models.DbSchema" Version="3.5.0" PrivateAssets="all" />
        <PackageReference Include="CodegenCS.Models.NSwagAdapter" Version="3.5.0" PrivateAssets="all" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <CodegenCSCompilerProvidedPackages>microsoft.codeanalysis.common;microsoft.codeanalysis.csharp;microsoft.codeanalysis.analyzers;system.collections.immutable;system.reflection.metadata;system.memory;system.buffers;system.numerics.vectors;system.runtime.compilerservices.unsafe;system.threading.tasks.extensions;system.text.encoding.codepages</CodegenCSCompilerProvidedPackages>
  </PropertyGroup>

  <Target Name="CodegenCSPackAnalyzer" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <_CodegenCSPackageRoslynApi>roslyn$([System.Version]::Parse('$(CodegenCSRoslynPackageVersion)').ToString(2))</_CodegenCSPackageRoslynApi>
      <_CodegenCSRoslynApi Condition="'$(TargetFramework)' == 'netstandard2.0'">$(_CodegenCSPackageRoslynApi)</_CodegenCSRoslynApi>
      <_CodegenCSRoslynApi Condition="'$(TargetFramework)' != 'netstandard2.0' And '$(CompilerApiVersion)' != '$(_CodegenCSPackageRoslynApi)'">$(CompilerApiVersion)</_CodegenCSRoslynApi>
      <_CodegenCSAnalyzerPath>analyzers/dotnet/$(_CodegenCSRoslynApi)/cs</_CodegenCSAnalyzerPath>
      <_CodegenCSProvided>;$(CodegenCSCompilerProvidedPackages.ToLowerInvariant());</_CodegenCSProvided>
    </PropertyGroup>
    <ItemGroup Condition="'$(_CodegenCSRoslynApi)' != ''">
      <_CodegenCSAnalyzerDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' And ('%(ReferenceCopyLocalPaths.Extension)' == '.dll' Or '%(ReferenceCopyLocalPaths.Extension)' == '.pdb') And !$(_CodegenCSProvided.Contains(';$([System.String]::Copy('%(ReferenceCopyLocalPaths.NuGetPackageId)').ToLowerInvariant());'))" />
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="$(_CodegenCSAnalyzerPath)" />
      <TfmSpecificPackageFile Include="$(TargetDir)$(TargetName).pdb" PackagePath="$(_CodegenCSAnalyzerPath)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <TfmSpecificPackageFile Include="@(_CodegenCSAnalyzerDependency)" PackagePath="$(_CodegenCSAnalyzerPath)" />
    </ItemGroup>
  </Target>

</Project>
