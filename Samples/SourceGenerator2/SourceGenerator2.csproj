<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodegenCS.SourceGenerator" Version="3.5.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Dapper.StrongName" Version="2.1.89" />
  </ItemGroup>

  <!-- 
  CodegenCS.SourceGenerator runs every AdditionalFiles item that defines CodegenCSOutput:
  If CodegenCSOutput="Memory" then the generated files (added to the compilation) are NOT saved to disk
  If CodegenCSOutput="File" then the generated files are saved to disk
  AdventureWorksSchema.json (a SQLite schema) is the model loaded by the template. It's also listed as AdditionalFiles
  (without CodegenCSOutput) so that editing it triggers the template again.
  -->
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="CodegenCSOutput" />
    <AdditionalFiles Include="SimplePOCOGenerator.csx" CodegenCSOutput="Memory" />
    <AdditionalFiles Include="AdventureWorksSchema.json" />
  </ItemGroup>

</Project>
